  <name>Nova CRM</name>
  <summary>Gestão de clientes, produtos, pedidos e cupons para pequenas lojas</summary>

  <developer id="br.com.novacrm">
    <name>Nova CRM Team</name>
  </developer>

  <description>
    <p>
      O Nova CRM é um aplicativo desktop para gerenciar o dia a dia de uma loja:
      cadastro de produtos e clientes, controle de pedidos, cupons de desconto,
      configuração da sua loja online, relatórios de faturamento e chat interno.
    </p>
    <p>Recursos principais:</p>
    <ul>
      <li>Dashboard com faturamento, vendas e pedidos pendentes</li>
      <li>Cadastro e importação/exportação de clientes e produtos via planilha</li>
      <li>Gestão de pedidos com status do fluxo de pagamento</li>
      <li>Cupons de desconto e construtor visual da loja</li>
      <li>Sincronização em tempo real com a nuvem (Firebase)</li>
    </ul>
  </description>

  <launchable type="desktop-id">br.com.novacrm.NovaCRM.desktop</launchable>

  <url type="homepage">https://novacrm.com.br</url>
